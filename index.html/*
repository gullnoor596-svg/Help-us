<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gull Khan Profile</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

/* BACKGROUND */
body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:
    radial-gradient(circle at top, rgba(255,60,0,0.3), transparent 50%),
    radial-gradient(circle at bottom, rgba(0,200,255,0.2), transparent 50%),
    url("https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1400&q=80");
    background-size:cover;
    background-position:center;
    overflow:hidden;
    color:white;
}

/* LOADER */
#loader{
    position:fixed;
    width:100%;
    height:100vh;
    background:#000;
    display:flex;
    justify-content:center;
    align-items:center;
    z-index:9999;
    transition:0.6s;
}

.welcome-box{
    font-size:15px;
    color:#00ff88;
    font-family:monospace;
    text-align:left;
    line-height:22px;
    white-space:pre-line;
    padding:20px;
    text-shadow:0 0 10px #00ff88;
}

.welcome-box::after{
    content:" ▌";
    animation:blink 0.7s infinite;
}

@keyframes blink{
    50%{opacity:0;}
}

/* CARD */
.card{
    width:340px;
    background:rgba(255,255,255,0.06);
    border-radius:25px;
    overflow:hidden;
    text-align:center;
    box-shadow:0 0 30px rgba(255,60,0,0.4);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,0.1);
    animation:float 3s ease-in-out infinite;
}

@keyframes float{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-12px)}
}

.card img{
    width:100%;
    height:340px;
    object-fit:cover;
    border-bottom:3px solid #ff3c00;
}

.content{
    padding:18px;
}

.name{
    font-size:26px;
    font-weight:bold;
    margin-bottom:15px;
    color:#ff3c00;
    text-shadow:0 0 15px #ff3c00;
}

/* BUTTONS (STABLE - NO SIZE CHANGE) */
.btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    margin:10px 0;
    padding:12px;
    border-radius:14px;
    text-decoration:none;
    color:white;
    font-size:15px;
    font-weight:bold;
    position:relative;
    overflow:hidden;

    /* IMPORTANT: no transform animation */
    transition: box-shadow 0.3s ease, filter 0.3s ease;
}

/* ❌ NO SCALE ON HOVER */
.btn:hover{
    transform:none;
    box-shadow:0 0 15px rgba(255,255,255,0.25);
}

/* ❌ NO SCALE ON CLICK */
.btn:active{
    transform:none;
}

/* CLICK EFFECT ONLY (GLOW) */
.btn.clicked{
    animation: neonClick 0.4s ease;
}

@keyframes neonClick{
    0%{
        filter:brightness(1);
        box-shadow:none;
    }
    50%{
        filter:brightness(1.4);
        box-shadow:0 0 25px rgba(0,255,255,0.6),
                   0 0 50px rgba(255,0,150,0.3);
    }
    100%{
        filter:brightness(1);
        box-shadow:none;
    }
}

/* COLORS */
.whatsapp{ background:linear-gradient(45deg,#25D366,#1ebc57); }
.facebook{ background:linear-gradient(45deg,#1877F2,#0d5fd3); }
.tiktok{ background:linear-gradient(45deg,#000,#222); border:1px solid #ff3c00;}
.gmail{ background:linear-gradient(45deg,#EA4335,#c5221f); }

.btn i{ font-size:18px; }

.hide{
    opacity:0;
    pointer-events:none;
}
</style>
</head>

<body>

<!-- LOADER -->
<div id="loader">
    <div class="welcome-box" id="terminal"></div>
</div>

<!-- CARD -->
<div class="card">

    <img src="https://raw.githubusercontent.com/gullnoor596-svg/Photo-load/refs/heads/main/1770988421959.jpg">

    <div class="content">

        <div class="name">Revolutionary Guard</div>

        <a class="btn whatsapp" href="https://whatsapp.com/channel/0029VbCbSoPCMY0JBsgwbx2q">
            <i class="fab fa-whatsapp"></i> WhatsApp
        </a>

        <a class="btn facebook" href="https://www.facebook.com/share/1CjBSTMvdV/">
            <i class="fab fa-facebook"></i> Facebook
        </a>

        <a class="btn tiktok" href="https://www.tiktok.com/@pathanwala1?_r=1&_t=ZS-95jDvPkhUlE">
            <i class="fab fa-tiktok"></i> TikTok
        </a>

        <a class="btn gmail" href="mailto:ffbiomaker@gmail.com">
            <i class="fas fa-envelope"></i> Gmail
        </a>

    </div>
</div>

<script>
window.addEventListener("load", function () {

    const textLines = [
        "> Initializing system...",
        "> Access granted ✔",
        "> Loading profile...",
        "> Welcome Gull Khan",
        "> FREE FIRE NAME: Tanzila Gull",
        "> FREE FIRE UID: 12043759712",
        "> System Ready ✔"
    ];

    const terminal = document.getElementById("terminal");

    let line = 0;
    let char = 0;

    function typeEffect() {
        if (line < textLines.length) {

            if (char < textLines[line].length) {
                terminal.innerHTML += textLines[line].charAt(char);
                char++;
                setTimeout(typeEffect, 35);
            } else {
                terminal.innerHTML += "<br>";
                line++;
                char = 0;
                setTimeout(typeEffect, 300);
            }

        } else {
            setTimeout(() => {
                document.getElementById("loader").classList.add("hide");
            }, 800);
        }
    }

    typeEffect();

    // CLICK EFFECT (NO SIZE CHANGE)
    document.querySelectorAll(".btn").forEach(btn => {
        btn.addEventListener("click", function () {

            this.classList.add("clicked");

            setTimeout(() => {
                this.classList.remove("clicked");
            }, 400);

        });
    });

});
</script>

</body>
</html>
